# ==============================================================================
# AskPodcast Environment Configuration Template
# Copy this file to '.env' and fill in your keys. NEVER commit '.env'.
# ==============================================================================

# --- DEFAULT PROVIDER: Google Gemini ---
LLM_PROVIDER=google_genai
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here
TEMPERATURE=0.2

# --- OPTION 2: OpenAI ---
# LLM_PROVIDER=openai
# CHAT_MODEL=gpt-4o
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-your-openai-key-here

# --- OPTION 3: Anthropic (Claude) ---
# Note: Anthropic does not produce embeddings; pair with Gemini or OpenAI embeddings.
# LLM_PROVIDER=anthropic
# CHAT_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- OPTION 4: xAI (Grok) ---
# LLM_PROVIDER=xai
# CHAT_MODEL=grok-2-latest
# XAI_API_KEY=xai-your-xai-key-here

# --- OPTION 5: Ollama (Local / Free / Offline) ---
# LLM_PROVIDER=ollama
# CHAT_MODEL=llama3.3:70b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-large
# OLLAMA_BASE_URL=http://localhost:11434
